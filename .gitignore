# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template MUST be committed (no secrets, documents required vars)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Large binary media — keep on disk, never commit
docs/*.mp4
docs/*.mov
docs/*.avi
docs/*.mkv
docs/*.webm

# ── V2: heavy/ephemeral artifacts — reproducible, never commit ───────────
# Model weights, indexes, and serialized state produced by verification runs.
**/fine_tuned_model/
**/quantized_model/
**/results/
**/triton_repo/
**/engine/
*.faiss
*.pkl
*.bin
*.safetensors
*.pt
*.pth

# Local vector store (Milvus Lite)
data/milvus_lite.db
data/*.db

# Notebook execution byproducts from the heal loop
**/*.executed.ipynb
**/*.iter*.ipynb
**/*.patched.ipynb
**/*.heal-report.json
**/*.trajectory.json
**/run0.ipynb

# Personal interview-prep material — not product artifacts
docs/INTERVIEW_*.md
docs/INTERVIEW_*.docx
docs/SETH_INTERVIEW_*.md
docs/SETH_INTERVIEW_*.docx

# Throwaway/debug scripts
scratch/
**/_*.py

# Claude Code worktrees + local session state
.claude/worktrees/
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Embedded git repos from other Claude sessions (worktrees)
.claude/worktrees/

# Local node_modules and build

# V2 service (Python / NAT) — generated artifacts
service/milvus.db
service/**/__pycache__/
service/*.egg-info/
service/.venv/
service/vectorstore.json
